# Business Compliance Hub - SIH Problem Statement 130
# Environment Configuration Template

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true

# CORS & Frontend Origin
FRONTEND_ORIGIN=http://localhost:3000

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_compliance_db

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload Storage Directory
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=15

# Frontend Public API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
