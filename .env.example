# ==============================================================================
# SIH PROBLEM STATEMENT 130 - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="Unified Compliance & Approval Platform"
APP_VERSION="1.0.0"

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (Defaults to SQLite for zero-config local run; set Postgres for production/docker)
# SQLite default: sqlite:///./app.db
# PostgreSQL: postgresql://sih_user:sih_password@localhost:5432/sih_db
# Docker Compose: postgresql://sih_user:sih_password@postgres:5432/sih_db
DATABASE_URL=sqlite:///./app.db

# JWT & Security Configuration
# Generate secure key in production: openssl rand -hex 32
JWT_SECRET_KEY=sih_super_secret_jwt_key_change_in_production_2026_hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML & LLM API Keys (For Developer 1 integration)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
USE_MOCK_AI_SERVICE=True

# Storage Configuration
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=15

# Frontend Configuration (for Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Bharat Compliance Portal (SIH-130)"
